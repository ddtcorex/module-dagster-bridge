<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/dagster-bridge/capabilities" method="GET">
        <service class="DDTCoreX\DagsterBridge\Api\CapabilitiesInterface" method="get"/>
        <resources>
            <resource ref="DDTCoreX_DagsterBridge::read"/>
        </resources>
    </route>
    <route url="/V1/dagster-bridge/products/index" method="GET">
        <service class="DDTCoreX\DagsterBridge\Api\ProductIndexInterface" method="getPage"/>
        <resources>
            <resource ref="DDTCoreX_DagsterBridge::read"/>
        </resources>
    </route>
    <route url="/V1/dagster-bridge/products/attribute-values" method="POST">
        <service class="DDTCoreX\DagsterBridge\Api\AttributeValuesInterface" method="get"/>
        <resources>
            <resource ref="DDTCoreX_DagsterBridge::read"/>
        </resources>
    </route>
</routes>
